{
  "name": "@nici8/imap-mcp",
  "version": "0.7.0-nml.1",
  "mcpName": "io.github.NICI8/imap-mcp",
  "description": "MCP server for IMAP mailboxes: read, search, organise and draft mail with attachments; it cannot send. Fork of @ni-c/imap-mcp.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "imap",
    "email",
    "mail",
    "mailbox",
    "read-only"
  ],
  "license": "MIT",
  "author": "Willi Thiel (original), Nicolas Muff-Luthiger (fork)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NICI8/imap-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/NICI8/imap-mcp/issues"
  },
  "homepage": "https://github.com/NICI8/imap-mcp#readme",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "imap-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.test.json",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "assets": "svg-asset-set",
    "assets:check": "svg-asset-set --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "fflate": "^0.8.3",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "mcp-approval": "^0.8.2",
    "mcp-tool-allowlist": "^0.2.1",
    "nodemailer": "10.3.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "^4.9.0",
    "mcp-integration-harness": "^0.4.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "svg-asset-set": "https://github.com/ni-c/svg-asset-set/releases/download/v0.3.0/svg-asset-set-0.3.0.tgz",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
